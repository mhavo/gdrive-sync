#!/usr/bin/env bash
# Bidirectional rclone bisync for selected Google Drive folders.
# Folder list: $CONF_DIR/folders.txt, where CONF_DIR is the directory of the
# profile being synced — by default ~/.config/gdrive-sync/<profile>. Settings
# live in the same directory in config.env (optional).
#
# One Google account is one profile. Profiles are equals: there is no default
# account and no primary, and each one owns its folders.txt, filter.txt and
# config.env.
#
# A folder is written into the list as a name, but the remote side is addressed
# by its Drive folder ID: on the first run the name is resolved to an ID and the
# ID is pinned in a state file. Renaming or moving the folder in Drive then does
# not break syncing, and — more to the point — does not change the address
# bisync works with, so there is nothing to abort on and nothing to diagnose.
set -uo pipefail

VERSION="0.1.0"

# --- Profiles ---------------------------------------------------------------
# A profile is a directory name under the two roots, and nothing else. There is
# no registry file: a second source of truth beside the directory layout would
# be free to disagree with it, and every other setting already lives in the
# profile's own directory.
CONF_ROOT="${GDRIVE_CONF_ROOT:-$HOME/.config/gdrive-sync}"
STATE_ROOT="${GDRIVE_STATE_ROOT:-$HOME/.local/state/gdrive-sync}"
PROFILE="${GDRIVE_PROFILE:-}"
# An empty --profile= is a mistake, not an omission, and is refused as one.
# Without this flag it would be indistinguishable from not passing the option.
PROFILE_GIVEN=0

# A profile name becomes a path segment and a systemd instance name at once.
# Anything outside this set would either escape the root or demand
# systemd-escape, so it is refused rather than mangled.
profile_valid() {
  local name="$1"
  [[ -n "$name" && "$name" != "." && "$name" != ".." ]] || return 1
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]]
}

# The directory listing is the profile list. Kept in one place for the same
# reason line parsing is: install.sh and the Omarchy widget both read it from
# here (--list-profiles) instead of scanning the directory themselves.
list_profiles() {
  local dir name
  for dir in "$CONF_ROOT"/*/; do
    [[ -d "$dir" ]] || continue
    name="${dir%/}"; name="${name##*/}"
    profile_valid "$name" || continue
    printf '%s\n' "$name"
  done
}

# --profile= has to be read before the Settings block, because CONF_DIR decides
# which config.env is read and the file cannot name the directory it lives in.
# This is the same documented exception GDRIVE_CONF_DIR already has. The equals
# form only, matching --only= and --repin=.
for arg in "$@"; do
  case "$arg" in
    --profile=*)     PROFILE="${arg#--profile=}"; PROFILE_GIVEN=1 ;;
    # Answered here so that it still answers when no profile can be resolved —
    # which is exactly the situation its callers ask about.
    --list-profiles) list_profiles; exit 0 ;;
  esac
done

# An explicit GDRIVE_CONF_DIR or GDRIVE_STATE_DIR wins over the profile. With
# both of them given the account has been named directly and no profile is
# needed at all.
if [[ -z "${GDRIVE_CONF_DIR:-}" || -z "${GDRIVE_STATE_DIR:-}" ]]; then
  if [[ -n "$PROFILE" ]] || (( PROFILE_GIVEN )); then
    if ! profile_valid "$PROFILE"; then
      echo "Invalid profile name: $PROFILE" >&2
      echo "A profile name is one path segment of [A-Za-z0-9._-], not . or .." >&2
      exit 2
    fi
  else
    mapfile -t PROFILES < <(list_profiles)
    case ${#PROFILES[@]} in
      1) PROFILE="${PROFILES[0]}" ;;
      0) echo "No profiles found in $CONF_ROOT" >&2
         echo "Create one:  install.sh --profile=NAME --remote=REMOTE" >&2
         exit 1 ;;
      # Guessing here means the wrong account, and deletions propagating to the
      # wrong Drive. With more than one profile there is no safe default, so
      # there is no default.
      *) echo "Several profiles exist — name one with --profile=NAME:" >&2
         printf '  %s\n' "${PROFILES[@]}" >&2
         exit 2 ;;
    esac
  fi
fi

# --- Settings ---------------------------------------------------------------
# The config file is optional. Without it the behaviour is the same as before it
# existed. The directory location comes from the profile, or from the
# environment (GDRIVE_CONF_DIR), because it has to be known before the file can
# be read; setting GDRIVE_CONF_DIR inside the file therefore has no effect, and
# neither does setting GDRIVE_PROFILE.
#
# Note: source runs the file as bash code. It is the user's own config file, but
# keep its permissions to yourself.
CONF_DIR="${GDRIVE_CONF_DIR:-$CONF_ROOT/$PROFILE}"
CONFIG_FILE="$CONF_DIR/config.env"
# shellcheck source=/dev/null
[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

REMOTE="${GDRIVE_REMOTE:-GoogleDrive}"
REMOTE="${REMOTE%:}"          # the spelling "GoogleDrive:" is allowed
# Per profile by default, which makes the common case non-colliding by
# construction — see check_local_collisions below for what a collision costs.
LOCAL_ROOT="${GDRIVE_LOCAL:-$HOME/GoogleDrive${PROFILE:+/$PROFILE}}"
FOLDERS="${GDRIVE_FOLDERS:-$CONF_DIR/folders.txt}"
FILTER="${GDRIVE_FILTER:-$CONF_DIR/filter.txt}"
STATE_DIR="${GDRIVE_STATE_DIR:-$STATE_ROOT/$PROFILE}"
INIT_DIR="$STATE_DIR/initialized"
LOCK="$STATE_DIR/lock"
STATUS_FILE="$STATE_DIR/status.json"

DRY_RUN=0
FORCE_RESYNC=0
ALLOW_EMPTY=0
ONLY=""
ACTION="sync"
REPIN=""
STATE_KEYS_REQUIRED=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run)  DRY_RUN=1 ;;
    --resync)      FORCE_RESYNC=1 ;;
    --only=*)      ONLY="${arg#--only=}" ;;
    --status)      ACTION="status" ;;
    --list-paths)  ACTION="list-paths" ;;
    # Both are consumed by the pre-scan above; listed so that they are not
    # reported as unknown options here.
    --profile=*)   ;;
    --list-profiles) ;;
    --repin)       ACTION="repin"; REPIN="" ;;
    --repin=*)     ACTION="repin"; REPIN="${arg#--repin=}" ;;
    --allow-empty-remote) ALLOW_EMPTY=1 ;;
    -V|--version)  printf 'gdrive-sync %s\n' "$VERSION"; exit 0 ;;
    -h|--help)
      cat <<HELP
gdrive-sync [options]

  -n, --dry-run     Preview operations without changing synced data or state
      --resync      Force bisync reinitialisation (--resync) for all folders
      --only=NAME   Process only this folder
      --status      List folders, pinned IDs and their current name in Drive
      --list-paths  Print the folder table: local path, tab, --only= value
                      (no network, no lock; gdrive-watch reads this)
      --repin[=NAME]  Resolve the folder ID again from the name
                      (requires reinitialisation next, done automatically)
      --profile=NAME  Which Google account to sync. With exactly one profile
                      it can be left out; with several it cannot
      --list-profiles Print the profiles, one per line, and exit
      --allow-empty-remote
                    Allow the run even if the remote folder is empty and the
                    local one is not. Use only when you emptied the folder in
                    Drive yourself.
  -h, --help        This help
  -V, --version     Print the version and exit

Profile:     ${PROFILE:-(none — GDRIVE_CONF_DIR given directly)}
Settings:    $CONFIG_FILE (optional)
Folder list: $FOLDERS
Local root:  $LOCAL_ROOT
Logs:        journalctl --user -u gdrive-sync@${PROFILE:-PROFILE} (or stdout when run by hand)
HELP
      exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

# --- The run record ---------------------------------------------------------
# status.json is what the Omarchy widget reads; nothing else consumes it. It is
# written only by a real sync run: a preview (-n) and the read-only queries must
# not overwrite the record of the last real run, or the desktop would report a
# preview as the last thing that happened.
TRIGGER="${GDRIVE_TRIGGER:-manual}"
STATUS_ENABLED=0
RUN_STARTED=""
if [[ "$ACTION" == "sync" ]] && (( ! DRY_RUN )); then
  STATUS_ENABLED=1
  # Not read before this point on purpose: --list-paths runs on a PATH that has
  # no date on it, and it has to keep working there.
  RUN_STARTED="$(date --iso-8601=seconds)"
fi

# The folder table of the run, as parallel arrays. A folder name contains
# spaces, brackets and slashes often enough that one string would not survive.
F_NAMES=(); F_RESULTS=(); F_ATS=(); F_REASONS=()

# Legacy state files replaced slashes and spaces with underscores, which is not
# one-to-one. Keep that spelling only for safe migration of existing markers.
legacy_slug() { local s="${1//\//_}"; printf '%s' "${s// /_}"; }

# Fixed-length state filenames derived from the complete logical identity.
state_hash() { printf '%s' "$1" | sha256sum | sed 's/[[:space:]].*//'; }

# --- Line parsing -----------------------------------------------------------
# A line is either a path from the root of Drive:
#     Projects/2026
# or a folder ID followed by the name of the local directory:
#     id:0BwyG7PLuwLCCWTR0UWJVc2kzQ0k  Archive
# spec=the line as written, path=remote path (empty on id: lines),
# fixed_id=the ID given on the line (empty on path lines), lname=local name,
# key=state file name, legacy_key=the pre-v2 state file name.
parse_line() {
  spec="$1"; path=""; fixed_id=""; lname=""; key=""; legacy_key=""
  if [[ "$spec" == id:* ]]; then
    local rest="${spec#id:}"
    fixed_id="${rest%%[[:space:]]*}"
    lname="${rest#"$fixed_id"}"
    lname="${lname#"${lname%%[![:space:]]*}"}"
    if [[ -z "$fixed_id" || -z "$lname" ]]; then
      echo "Invalid line (an id: line needs a local name): $spec" >&2
      return 1
    fi
    legacy_key="id_$(legacy_slug "$lname")"
    (( STATE_KEYS_REQUIRED )) && key="id_$(state_hash "$lname")"
  else
    path="$spec"; lname="$spec"
    legacy_key="$(legacy_slug "$path")"
    (( STATE_KEYS_REQUIRED )) && key="path_$(state_hash "$path")"
  fi
  return 0
}

# --only= matches either spelling of the line: the line as written, or the local
# folder name. Defined next to parse_line, because it reads what parse_line set.
selected() {
  [[ -z "$ONLY" ]] && return 0
  [[ "$ONLY" == "$spec" || "$ONLY" == "$lname" ]]
}

# --- Reading the folder list ------------------------------------------------
# Fills the LINES array. Its own function, because --list-paths needs it before
# the lock and the other actions after it; parsing stays in one place.
load_lines() {
  [[ -f "$FOLDERS" ]] || { echo "Folder list not found: $FOLDERS" >&2; exit 1; }
  mapfile -t LINES < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$FOLDERS" | grep -v '^$')
  if (( ${#LINES[@]} == 0 )); then
    echo "Folder list is empty — add folders to $FOLDERS" >&2
    exit 1
  fi
}

# Refuse two entries that address the same local directory. This also catches a
# path entry and an id: entry that would otherwise run two bisync histories over
# one tree.
validate_lines() {
  local spec_line local_path previous i
  local -a seen_paths=() seen_specs=()
  for spec_line in "${LINES[@]}"; do
    parse_line "$spec_line" || continue
    local_path="$LOCAL_ROOT/$lname"
    for i in "${!seen_paths[@]}"; do
      if [[ "${seen_paths[$i]}" == "$local_path" ]]; then
        previous="${seen_specs[$i]}"
        echo "Duplicate local folder '$local_path' in $FOLDERS" >&2
        echo "  first: $previous" >&2
        echo "  again: $spec_line" >&2
        return 1
      fi
    done
    seen_paths+=("$local_path")
    seen_specs+=("$spec_line")
  done
}

# --- --list-paths -----------------------------------------------------------
# A plain read of folders.txt for gdrive-watch: no network, no state files, no
# lock. Handled before the jq check, because no ID is resolved — a missing jq
# must not stop the watcher from starting.
#
# An invalid line is reported on stderr but does not break the output: a
# non-zero return value would make gdrive-watch refuse to watch any folder at
# all, so one broken line would end watching for everything. Zero lines is not
# a table at all, and that is an error.
if [[ "$ACTION" == "list-paths" ]]; then
  load_lines
  validate_lines || exit 1
  printed=0
  for spec_line in "${LINES[@]}"; do
    parse_line "$spec_line" || continue
    printf '%s\t%s\n' "$LOCAL_ROOT/$lname" "$lname"
    printed=1
  done
  (( printed )) || { echo "No line in the folder list is valid: $FOLDERS" >&2; exit 1; }
  exit 0
fi

command -v jq >/dev/null || { echo "jq is missing — needed to resolve IDs" >&2; exit 1; }
command -v sha256sum >/dev/null || { echo "sha256sum is missing — needed for state keys" >&2; exit 1; }
STATE_KEYS_REQUIRED=1

# Built with jq, never by pasting strings together: folder names come from
# Google Drive and contain quotes, backslashes and newlines as readily as
# anything else a user can type.
status_write() {
  (( STATUS_ENABLED )) || return 0
  local finished="$1" exit_code="$2" tmp folders_json i
  local -a entries=()
  for i in "${!F_NAMES[@]}"; do
    entries+=("$(jq -nc \
      --arg name "${F_NAMES[$i]}" --arg result "${F_RESULTS[$i]}" \
      --arg at "${F_ATS[$i]}" --arg reason "${F_REASONS[$i]}" \
      '{name: $name, result: $result, at: $at}
       + (if $reason == "" then {} else {reason: $reason} end)')") || return 0
  done
  folders_json="$(printf '%s\n' "${entries[@]+"${entries[@]}"}" | jq -sc '.')" || return 0

  # The temporary file is in the same directory as the target, so the mv is a
  # rename inside one filesystem and therefore atomic. A reader polling the file
  # sees either the previous run record or this one, never half of either.
  tmp="$STATUS_FILE.tmp.$$"
  if jq -n \
      --arg version "$VERSION" \
      --arg started "$RUN_STARTED" \
      --arg finished "$finished" \
      --arg exit_code "$exit_code" \
      --arg trigger "$TRIGGER" \
      --argjson folders "$folders_json" \
      '{schema: 1,
        version: $version,
        run: {
          started:  $started,
          finished: (if $finished  == "" then null else $finished end),
          exit:     (if $exit_code == "" then null else ($exit_code | tonumber) end),
          trigger:  $trigger,
          dryRun:   false
        },
        folders: $folders}' > "$tmp" 2>/dev/null; then
    mv -- "$tmp" "$STATUS_FILE" || rm -f -- "$tmp"
  else
    rm -f -- "$tmp"
  fi
  return 0
}

# Every selected folder starts as "running" so that the file names the work
# still outstanding, not only what has already finished. Each folder's entry is
# replaced by its real result as it completes.
status_init_folders() {
  (( STATUS_ENABLED )) || return 0
  local spec_line parsed
  F_NAMES=(); F_RESULTS=(); F_ATS=(); F_REASONS=()
  for spec_line in "${LINES[@]}"; do
    # The parse error itself is reported by the main loop; this pass is silent
    # so the message is not printed twice.
    if parse_line "$spec_line" 2>/dev/null; then parsed=1; else parsed=0; fi
    selected || continue
    if (( parsed )); then F_NAMES+=("$lname"); else F_NAMES+=("$spec_line"); fi
    F_RESULTS+=("running"); F_ATS+=("$RUN_STARTED"); F_REASONS+=("")
  done
}

# Records one folder's outcome and republishes the file. validate_lines has
# already refused two entries with the same local name, so the name identifies
# exactly one row.
status_folder_result() {
  (( STATUS_ENABLED )) || return 0
  local name="$1" result="$2" reason="${3:-}" i
  for i in "${!F_NAMES[@]}"; do
    if [[ "${F_NAMES[$i]}" == "$name" ]]; then
      F_RESULTS[i]="$result"
      F_ATS[i]="$(date --iso-8601=seconds)"
      F_REASONS[i]="$reason"
      break
    fi
  done
  status_write "" ""
}

# Runs from the EXIT trap only, which is why shellcheck cannot see the call.
# $? has to be read first: everything after this line overwrites it.
# shellcheck disable=SC2329
status_finish() {
  local rc=$?
  status_write "$(date --iso-8601=seconds)" "$rc"
}

# --- Local root collisions --------------------------------------------------
# Two profiles under one local root, or under nested roots, means each one's
# bisync sees the other's files as local changes and carries their absence to
# its own Drive. The failure is silent, bidirectional and not obviously
# recoverable, so it is refused before the run rather than diagnosed after it.

# config.env is bash. Sourcing another profile's file into this shell would
# overwrite the settings of the profile actually being synced — the check would
# corrupt the run it exists to protect — so each one is read in a subshell that
# prints only the resulting local root.
other_profile_local() {
  local name="$1"
  ( set +u
    GDRIVE_LOCAL=""
    # shellcheck source=/dev/null
    [[ -r "$CONF_ROOT/$name/config.env" ]] && source "$CONF_ROOT/$name/config.env"
    printf '%s\n' "${GDRIVE_LOCAL:-$HOME/GoogleDrive/$name}" )
}

# The comparison is on realpath output: a symlink must not be able to hide a
# nesting relationship. -m, because a root that does not exist yet is the
# normal case on a freshly created profile.
check_local_collisions() {
  local mine other other_root name
  mine="$(realpath -m -- "$LOCAL_ROOT")" || return 0
  while IFS= read -r name; do
    [[ -n "$name" && "$name" != "$PROFILE" ]] || continue
    other_root="$(other_profile_local "$name")"
    [[ -n "$other_root" ]] || continue
    other="$(realpath -m -- "$other_root")" || continue
    if [[ "$mine" == "$other" || "$mine" == "$other"/* || "$other" == "$mine"/* ]]; then
      echo "Local root collision with profile '$name':" >&2
      printf "  this profile ('%s'): %s\n" "$PROFILE" "$mine" >&2
      printf "  profile '%s': %s\n" "$name" "$other" >&2
      echo "Two profiles may not share or nest their local roots — each one's" >&2
      echo "bisync would carry the other's files to its own Drive as deletions." >&2
      return 1
    fi
  done < <(list_profiles)
  return 0
}

# Only the actions that address the folders. --status and --list-paths report
# on a configuration without touching data, and must keep working while a
# collision is being fixed. A preview is checked too: -n exists to show what a
# real run would do, and a real run here would be refused.
if [[ -n "$PROFILE" && ( "$ACTION" == "sync" || "$ACTION" == "repin" ) ]]; then
  check_local_collisions || exit 1
fi

# Real runs create and lock persistent state. A dry-run takes the existing lock
# read-only when one exists, but does not create state merely to preview work.
if (( ! DRY_RUN )); then
  mkdir -p "$INIT_DIR" "$LOCAL_ROOT"
  exec 9>"$LOCK"
elif [[ -r "$LOCK" ]]; then
  exec 9<"$LOCK"
fi
# From here every exit is the end of a run, including the failure to get the
# lock and a folder list that turns out to be missing. A trap is the only way to
# write the closing record from all of them without repeating it at each exit.
(( STATUS_ENABLED )) && trap status_finish EXIT

if { (( ! DRY_RUN )) || [[ -r "$LOCK" ]]; } && ! flock -n 9; then
  # 75 = EX_TEMPFAIL: "try again later". For the timer an overlapping run is not
  # an error (SuccessExitStatus=75), but gdrive-watch needs to tell it apart
  # from a successful run: otherwise a missed change would be recorded as synced.
  echo "gdrive-sync is already running, skipping." >&2
  exit 75
fi

load_lines
validate_lines || exit 1

# Everything this script says goes to stdout and nowhere else: under the systemd
# units that is the journal, and by hand it is the terminal. No log file is
# written, so there is none to rotate and none to fill the disk.
log() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }

# The first of the three writes: the run has started, nothing has finished.
status_init_folders
status_write "" ""

COMMON=(
  --drive-export-formats url
  --drive-skip-dangling-shortcuts
  --filter-from "$FILTER"
  --create-empty-src-dirs
  --transfers 8
  --checkers 16
  --tpslimit 10
  --retries 3
  --low-level-retries 10
)
# No --log-file: rclone's own output goes to stdout with the rest of the run.
(( DRY_RUN )) || COMMON+=(--log-level INFO)
BISYNC_OPTS=(
  --conflict-resolve newer
  --conflict-loser num
  --conflict-suffix conflict
  --resilient
  --recover
  --max-lock 15m
  # Quoted for shellcheck's benefit (SC2054): the comma belongs to rclone's
  # own value syntax, it does not separate array elements.
  --compare 'size,modtime'
  --modify-window 1s
)
(( DRY_RUN )) && BISYNC_OPTS+=(--dry-run)

# --- State file -------------------------------------------------------------
# initialized/<key> holds key=value lines: id, name, path, pinned.
# An empty file = an old name-based initialisation that needs pinning.
marker_get() {
  local file="$1" field="$2"
  [[ -s "$file" ]] || return 1
  local val
  val="$(sed -n "s/^$field=//p" "$file" | head -1)"
  [[ -n "$val" ]] || return 1
  printf '%s' "$val"
}

marker_write() {
  local file="$1" id="$2" name="$3" path="$4" pending="${5:-0}"
  local tmp="${file}.tmp.$$"
  {
    printf 'id=%s\n' "$id"
    printf 'name=%s\n' "$name"
    printf 'path=%s\n' "$path"
    printf 'pinned=%s\n' "$(date --iso-8601=seconds)"
    (( pending )) && printf 'resync=1\n'
  } > "$tmp" || return 1
  mv -- "$tmp" "$file"
}

marker_matches_identity() {
  local file="$1" stored_name stored_path
  [[ -s "$file" ]] || return 1
  stored_name="$(sed -n 's/^name=//p' "$file" | head -1)"
  stored_path="$(sed -n 's/^path=//p' "$file" | head -1)"
  if [[ -n "$fixed_id" ]]; then
    [[ "$stored_name" == "$lname" && -z "$stored_path" ]]
  else
    [[ "$stored_path" == "$path" ]]
  fi
}

marker_for_read() {
  local current="$INIT_DIR/$key" legacy="$INIT_DIR/$legacy_key"
  if marker_matches_identity "$current"; then
    printf '%s' "$current"
  elif marker_matches_identity "$legacy"; then
    printf '%s' "$legacy"
  else
    return 1
  fi
}

prepare_marker() {
  marker="$INIT_DIR/$key"
  local legacy="$INIT_DIR/$legacy_key"
  if [[ -e "$marker" ]]; then
    if ! marker_matches_identity "$marker"; then
      log "==> $lname: ERROR — state marker does not match this folder, refusing to sync"
      return 1
    fi
    return 0
  fi
  if [[ -s "$legacy" ]]; then
    if marker_matches_identity "$legacy"; then
      if (( DRY_RUN )); then
        marker="$legacy"
      elif ! cp -- "$legacy" "$marker"; then
        log "==> $lname: ERROR — could not migrate legacy state marker"
        return 1
      fi
    else
      log "==> $lname: ignoring a colliding legacy state marker"
    fi
  fi
}

# --- Resolving the ID -------------------------------------------------------
remote_for() { printf '%s,root_folder_id=%s:' "$REMOTE" "$1"; }

# Resolve every path component by ID. Drive permits duplicate names, so a name
# is safe to pin only when it identifies exactly one distinct target.
resolve_id() {
  local requested="$1" component json matches address current_id=""
  local -a components ids
  IFS='/' read -r -a components <<< "$requested"
  (( ${#components[@]} > 0 )) || return 1
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || return 1
    if [[ -n "$current_id" ]]; then address="$(remote_for "$current_id")"; else address="$REMOTE:"; fi
    json="$(rclone lsjson "$address" --dirs-only --drive-skip-dangling-shortcuts 2>/dev/null)" || return 1
    matches="$(printf '%s' "$json" | jq -r --arg n "$component" \
      '[.[] | select(.Name == $n) | (.ID | sub(".*\\t"; ""))] | unique[]')" || return 1
    mapfile -t ids <<< "$matches"
    [[ -n "$matches" && ${#ids[@]} -eq 1 ]] || {
      [[ -n "$matches" ]] && return 2
      return 1
    }
    current_id="${ids[0]}"
  done
  printf '%s' "$current_id"
}

# The current name in Drive for a pinned ID, from the parent folder listing.
current_name() {
  local path="$1" id="$2" parent json
  if [[ "$path" == */* ]]; then parent="${path%/*}"; else parent=""; fi
  json="$(rclone lsjson "$REMOTE:$parent" --dirs-only --drive-skip-dangling-shortcuts 2>/dev/null)" || return 1
  printf '%s' "$json" \
    | jq -r --arg id "$id" '.[] | select((.ID | sub(".*\t";"")) == $id) | .Name' | head -1
}

# --- --status ---------------------------------------------------------------
if [[ "$ACTION" == "status" ]]; then
  for spec_line in "${LINES[@]}"; do
    parse_line "$spec_line" || { rc_total=1; continue; }
    selected || continue
    marker="$(marker_for_read)" || marker="$INIT_DIR/$key"
    id="$(marker_get "$marker" id)" || id=""
    if [[ -z "$id" ]]; then
      id="$fixed_id"
      [[ -n "$id" ]] && pin_state="given on the line" || pin_state="NOT PINNED (will be initialised on the next run)"
    else
      pin_state="pinned $(marker_get "$marker" pinned || echo '?')"
    fi
    printf '%s\n' "$spec_line"
    printf '  local     : %s\n' "$LOCAL_ROOT/$lname"
    printf '  ID        : %s (%s)\n' "${id:-–}" "$pin_state"
    if [[ -n "$id" ]]; then
      if rclone lsf --max-depth 1 "$(remote_for "$id")" >/dev/null 2>&1; then
        if [[ -n "$path" ]]; then
          cur="$(current_name "$path" "$id")"
          if [[ -z "$cur" ]]; then
            printf '  in Drive  : not found in parent folder %s — moved?\n' "${path%/*}"
          elif [[ "$cur" != "${path##*/}" ]]; then
            printf '  in Drive  : renamed: %s\n' "$cur"
          else
            printf '  in Drive  : %s\n' "$cur"
          fi
        else
          printf '  in Drive  : ID matches\n'
        fi
      else
        printf '  in Drive  : ID DOES NOT RESOLVE — deleted or permissions changed\n'
      fi
    fi
    printf '\n'
  done
  exit 0
fi

# --- Main loop --------------------------------------------------------------
rc_total=0

for spec_line in "${LINES[@]}"; do
  if ! parse_line "$spec_line"; then
    rc_total=1
    status_folder_result "$spec_line" error "Invalid line (an id: line needs a local name): $spec_line"
    continue
  fi
  selected || continue

  marker="$INIT_DIR/$key"
  local_path="$LOCAL_ROOT/$lname"
  (( DRY_RUN )) || mkdir -p "$local_path"

  if ! prepare_marker; then
    rc_total=1
    status_folder_result "$lname" error "state marker does not match this folder, refusing to sync"
    continue
  fi

  need_resync=0
  (( FORCE_RESYNC )) && need_resync=1

  id="$(marker_get "$marker" id)" || id=""
  marker_get "$marker" resync >/dev/null && need_resync=1

  # Pinning: an ID given on the line always wins, otherwise it is resolved from
  # the name.
  if [[ "$ACTION" == "repin" ]]; then
    if [[ -n "$REPIN" && "$REPIN" != "$spec" && "$REPIN" != "$lname" ]]; then continue; fi
    [[ -n "$path" ]] || { log "==> $lname: --repin does not apply to id: lines"; continue; }
    id=""
  fi

  if [[ -n "$fixed_id" ]]; then
    if [[ "$id" != "$fixed_id" ]]; then
      id="$fixed_id"; need_resync=1
      if (( ! DRY_RUN )) && ! marker_write "$marker" "$id" "$lname" "" 1; then
        log "==> $lname: ERROR — could not persist pending initialization"
        rc_total=1
        status_folder_result "$lname" error "could not persist pending initialization"
        continue
      fi
      log "==> $lname: ID taken from the line, reinitialising"
    fi
  elif [[ -z "$id" ]]; then
    log "==> $lname: resolving the folder ID from Drive"
    id="$(resolve_id "$path")"
    resolve_rc=$?
    if (( resolve_rc != 0 )); then
      if (( resolve_rc == 2 )); then
        reason="folder path '$path' is ambiguous in Drive; use an id: entry"
      else
        reason="folder not found in Drive at path '$path'"
      fi
      log "    $lname: ERROR — $reason"
      rc_total=1
      status_folder_result "$lname" error "$reason"
      continue
    fi
    # Moving from a name-based initialisation changes the remote address, so
    # bisync's comparison listings have to be rebuilt.
    need_resync=1
    if (( ! DRY_RUN )) && ! marker_write "$marker" "$id" "${path##*/}" "$path" 1; then
      log "==> $lname: ERROR — could not persist pending initialization"
      rc_total=1
      status_folder_result "$lname" error "could not persist pending initialization"
      continue
    fi
    log "    $lname: ID $id"
  fi

  if [[ "$ACTION" == "repin" ]]; then
    log "    $lname: repinned, the next run will initialise"
    continue
  fi

  remote="$(remote_for "$id")"

  # Safety gate: the ID has to resolve, and the remote folder must not be empty
  # while the local one is not. Both are symptoms of the same thing — the folder
  # was deleted, is in the trash, or permissions changed. bisync would abort on
  # its own here; the point of checking first is a named reason for the one
  # folder affected, while the others keep syncing.
  if ! remote_head="$(rclone lsf --max-depth 1 "$remote" 2>/dev/null)"; then
    reason="ID $id does not resolve in Drive, skipping (no bisync)"
    log "==> $lname: ERROR — $reason"
    rc_total=1
    status_folder_result "$lname" error "$reason"
    continue
  fi
  if (( ! ALLOW_EMPTY )) && [[ -z "$remote_head" ]] \
     && [[ -n "$(ls -A "$local_path" 2>/dev/null)" ]]; then
    reason="remote folder is empty but local is not. Skipping."
    log "==> $lname: ERROR — $reason"
    log "    Check Drive. If you emptied the folder on purpose: --allow-empty-remote"
    rc_total=1
    # Not an error result: the folder was left alone deliberately, and the
    # widget shows a skip differently from a failure.
    status_folder_result "$lname" skipped "$reason"
    continue
  fi

  opts=("${BISYNC_OPTS[@]}")
  if (( need_resync )) || [[ ! -e "$marker" ]]; then
    log "==> $lname: initialising (--resync)"
    opts+=(--resync --resync-mode newer)
    ok_result="initialising"
  else
    log "==> $lname: bisync"
    ok_result="ok"
  fi

  if rclone bisync "$remote" "$local_path" "${opts[@]}" "${COMMON[@]}"; then
    log "    $lname: OK"
    if (( ! DRY_RUN )); then
      if [[ ! -s "$marker" ]] && ! marker_write "$marker" "$id" "$lname" "$path" 0; then
        log "    $lname: ERROR — sync succeeded but state could not be persisted"
        rc_total=1
        status_folder_result "$lname" error "sync succeeded but state could not be persisted"
        continue
      fi
      if ! sed -i '/^resync=1$/d' "$marker"; then
        log "    $lname: ERROR — sync succeeded but pending initialization could not be cleared"
        rc_total=1
        status_folder_result "$lname" error "sync succeeded but pending initialization could not be cleared"
        continue
      fi
    fi
    status_folder_result "$lname" "$ok_result"
  else
    rc=$?
    rc_total=1
    log "    $lname: ERROR (rclone exit $rc) — see the output above"
    status_folder_result "$lname" error "rclone exit $rc"
  fi
done

exit $rc_total
