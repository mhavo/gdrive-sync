[Unit]
Description=Bidirectional rclone bisync with Google Drive (profile %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/gdrive-sync
# The profile this instance syncs. Passed as an environment variable rather
# than as a --profile flag so that ExecStart stays the one line it has always
# been, identical for every instance.
Environment=GDRIVE_PROFILE=%i
# Recorded in status.json, so the desktop widget can tell an unattended run
# apart from one the user started.
Environment=GDRIVE_TRIGGER=timer
# 75 = an overlapping run (gdrive-watch held the lock). Not an error for the timer.
SuccessExitStatus=75
# rclone runs at --log-level INFO and the whole run goes to the journal, so a
# sync over many folders produces thousands of lines in a short burst. systemd's
# default rate limit (about 10 000 messages per 30 s) would drop the excess
# silently, leaving a log that looks complete and is not. There is no partial
# setting worth having here: either the record of a run is whole or it is
# useless for diagnosing one.
LogRateLimitIntervalSec=0
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
