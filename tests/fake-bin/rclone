#!/usr/bin/env bash
# Deterministic rclone double. Tests opt into responses through environment
# variables; no test may reach the user's real remote or rclone configuration.
set -uo pipefail

if [[ -n "${RCLONE_CALLS:-}" ]]; then
  {
    printf 'command=%s\n' "${1:-}"
    printf 'arg=%s\n' "$@"
  } >> "$RCLONE_CALLS"
fi

case "${1:-}" in
  lsjson)
    if [[ "${2:-}" == *,root_folder_id=* ]]; then
      printf '%s\n' "${RCLONE_LSJSON_CHILD:-${RCLONE_LSJSON:-[]}}"
    else
      printf '%s\n' "${RCLONE_LSJSON_ROOT:-${RCLONE_LSJSON:-[]}}"
    fi
    exit "${RCLONE_LSJSON_RC:-0}"
    ;;
  lsd)
    printf '%s' "${RCLONE_LSD_OUTPUT:-          -1 2026-01-01 00:00:00        -1 Documents}"
    exit "${RCLONE_LSD_RC:-0}"
    ;;
  lsf)
    # ${VAR-default}, not ${VAR:-default}: an empty listing is a real answer
    # from Drive (the folder exists but has nothing in it) and a test has to be
    # able to ask for it.
    printf '%s' "${RCLONE_LSF_OUTPUT-remote-entry}"
    exit "${RCLONE_LSF_RC:-0}"
    ;;
  bisync)
    # A slow bisync is the only way a test can look at a run while it is still
    # going: the in-progress status.json exists for exactly that window.
    [[ -n "${RCLONE_BISYNC_SLEEP:-}" ]] && sleep "$RCLONE_BISYNC_SLEEP"
    exit "${RCLONE_BISYNC_RC:-0}"
    ;;
  *)
    printf 'unexpected fake rclone command: %s\n' "${1:-<none>}" >&2
    exit 97
    ;;
esac
