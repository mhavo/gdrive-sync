# Settings for gdrive-sync. Copy this file to
#   ~/.config/rclone-gdrive-sync/config.env
# and uncomment the lines you want to change.
#
# The file is optional. Without it the defaults shown below are used.
#
# NOTE: the file is executed as bash code (source). Write only variable
# assignments into it, and keep its permissions to yourself (chmod 600).

# rclone remote name (rclone config). A trailing colon is optional.
#GDRIVE_REMOTE=GoogleDrive

# Local root directory the folders are synced under.
#GDRIVE_LOCAL=$HOME/GoogleDrive

# Config directory. This one is an exception: it is read from the environment
# before this file is read, so setting it here has no effect. Use the
# environment variable if you want it elsewhere:
#   GDRIVE_CONF_DIR=~/.config/gdrive-sync gdrive-sync --status
#GDRIVE_CONF_DIR=$HOME/.config/rclone-gdrive-sync

# State directory: pinned folder IDs, logs and the lock file.
#GDRIVE_STATE_DIR=$HOME/.local/state/rclone-gdrive-sync

# Folder list and rclone's filter file. In the config directory by default.
#GDRIVE_FOLDERS=$HOME/.config/rclone-gdrive-sync/folders.txt
#GDRIVE_FILTER=$HOME/.config/rclone-gdrive-sync/filter.txt

# --- gdrive-watch -----------------------------------------------------------
# The watcher listens for local changes and syncs the changed folder right away.
# The timer stays as it is, for changes on Drive's side.

# Debounce in seconds: how long changes must be quiet before the sync runs.
#GDRIVE_DEBOUNCE_SEC=5

# Retry in seconds, when the previous run was still going (the lock was held).
#GDRIVE_RETRY_SEC=30

# Which gdrive-sync to run: a name on PATH or a full path. The systemd unit sets
# this itself, because a user session's PATH does not necessarily include
# ~/.local/bin.
#GDRIVE_SYNC_BIN=gdrive-sync
